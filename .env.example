# Multi-Platform Social Media Bot Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# Database Configuration (Supabase)
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_PROJECT_REF=your-project-ref

# =============================================================================
# OpenAI Configuration
# =============================================================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# =============================================================================
# Application Configuration
# =============================================================================
DRY_RUN=false
CREDENTIAL_FILE=./config/credentials.json
PORT=8080

# =============================================================================
# Legacy Configuration (for migration from CockroachDB)
# These are only needed when running the migration tool
# =============================================================================
# DB_CLUSTER_ID=your_cockroach_cluster_id
# DB_USERNAME=your_cockroach_username
# DB_PASSWORD=your_cockroach_password
# DB_HOST=your_cockroach_host
# DB_NAME=your_cockroach_database
