# 1Password CLI Environment Variables Template
# Use with: op run --env-file=.env.op -- <command>

# =============================================================================
# Database Configuration (1Password CLI format)
# =============================================================================
POSTGRES_URL="op://pedro/POSTGRES_URL/credential"

# Optional: Alternative format using individual fields
# SUPABASE_PRIV_KEY="op://pedro/SUPABASE_PRIV_KEY/credential"
# SUPABASE_PROJECT_REF="op://pedro/SUPABASE_URL/credential"

# =============================================================================
# Platform Credentials (1Password CLI format)
# =============================================================================

# Twitch (if needed)
# TWITCH_ID="op://pedro/TWITCH_ID/credential"
# TWITCH_SECRET="op://pedro/TWITCH_SECRET/credential"

# Discord
# DISCORD_SECRET="op://pedro/DISCORD_SECRET/credential"
# DISCORD_CLIENT_ID="op://pedro/DISCORD_CLIENT_ID/credential"
# DISCORD_PUBLIC_KEY="op://pedro/DISCORD_PUBLIC_KEY/credential"

# Supabase API Keys
# SUPABASE_PUB_KEY="op://pedro/SUPABASE_PUB_KEY/credential"
# SUPABASE_JWT="op://pedro/SUPABASE_JWT/credential"

# =============================================================================
# Application Configuration
# =============================================================================
DRY_RUN=false
PORT=8080
